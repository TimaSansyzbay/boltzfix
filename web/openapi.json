          },
          "reserved": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Reserved"
          },
          "wall_seconds": {
            "type": "number",
            "title": "Wall Seconds"
          },
          "outstanding_remote": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Outstanding Remote"
          },
          "timing_basis": {
            "type": "string",
            "title": "Timing Basis",
            "default": "service allowances and wall time; not equal GPU time"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "limits",
          "used",
          "reserved",
          "wall_seconds",
          "outstanding_remote"
        ],
        "title": "BudgetLedger"
      },
      "BudgetLimits": {
        "properties": {
          "samples": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Samples",
            "default": 4
          },
          "prediction_requests": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Prediction Requests",
            "default": 4
          },
          "refinements": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Refinements",
            "default": 2
          },
          "epochs": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Epochs",
            "default": 6
          },
          "llm_calls": {
            "type": "integer",
            "maximum": 36.0,
            "minimum": 0.0,
            "title": "Llm Calls",
            "default": 36
          },
          "llm_tokens": {
            "type": "integer",
            "maximum": 60000.0,
            "minimum": 0.0,
            "title": "Llm Tokens",
            "default": 60000
          },
          "wall_seconds": {
            "type": "integer",
            "maximum": 1800.0,
            "minimum": 10.0,
            "title": "Wall Seconds",
            "default": 1800
          },
          "refinement_timeout": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Refinement Timeout",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BudgetLimits"
      },
      "Candidate": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "action_id": {
            "type": "string",
            "title": "Action Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "prediction",
              "minimized"
            ],
            "title": "Kind"
          },
          "artifact_ids": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Artifact Ids"
          },
          "diagnostics": {
            "$ref": "#/components/schemas/DiagnosticReport"
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "run_id",
          "action_id",
          "kind",
          "artifact_ids",
          "diagnostics",
          "provenance"
        ],
        "title": "Candidate"
      },
      "Check": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown",
              "not_applicable",
              "tool_error"
            ],
            "title": "Status"
          },
          "category": {
            "type": "string",
            "enum": [
              "identity",
              "geometry",
              "environment",
              "protocol",
              "tool"
            ],
            "title": "Category"
          },
          "value": {
            "title": "Value"
          },
          "detail": {
            "type": "string",
            "title": "Detail",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "status",
          "category"
        ],
        "title": "Check"
      },
      "DiagnosticReport": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version",
            "default": "diagnostics-v1"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "array",
            "title": "Checks"
          },
          "chemically_eligible": {
            "type": "boolean",
            "title": "Chemically Eligible"
          },
          "physical_valid": {
            "type": "boolean",
            "title": "Physical Valid"
          },
          "failed_physical": {
            "type": "integer",
            "title": "Failed Physical"
          },
          "severe_clashes": {
            "type": "integer",
            "title": "Severe Clashes"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "confidence_source": {
            "type": "string",
            "title": "Confidence Source",
            "default": "not_reported"
          },
          "inherited_confidence": {
            "type": "boolean",
            "title": "Inherited Confidence",
            "default": false
          },
          "closest_contacts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Closest Contacts"
          },
          "tool_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Tool Versions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "checks",
          "chemically_eligible",
          "physical_valid",
          "failed_physical",
          "severe_clashes"
        ],
        "title": "DiagnosticReport"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RunConfig": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "default": "Untitled investigation"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,60}$",
            "title": "Case Id",
            "default": "interactive"
          },
          "sequence": {
            "type": "string",
            "maxLength": 400,
            "minLength": 100,
            "title": "Sequence"
          },
          "ligand_smiles": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Ligand Smiles"
          },
          "msa": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Msa"
          },
          "provider": {
            "type": "string",
            "enum": [
              "mock",
              "auto",
              "nvidia_nim",
              "nebius_mcp",
              "nvidia_diffdock",
              "imported"
            ],
            "title": "Provider",
            "default": "mock"
          },
          "protein_pdb": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 3000000
              },
              {
                "type": "null"
              }
            ],
            "title": "Protein Pdb"
          },
          "initial_samples": {
            "type": "integer",
            "maximum": 4.0,
            "minimum": 0.0,
            "title": "Initial Samples",
            "default": 1
          },
          "input_ligands": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Input Ligands"
          },
          "policy": {
            "type": "string",
            "enum": [
              "collective",
              "single_agent",
              "fixed_resampling",
              "fixed_hybrid",
              "rules",
              "initial",
              "isolated"
            ],
            "title": "Policy",
            "default": "collective"
          },
          "agent_mode": {
            "type": "string",
            "enum": [
              "synthetic",
              "live"
            ],
            "title": "Agent Mode",
            "default": "synthetic"
          },
          "budget": {
            "$ref": "#/components/schemas/BudgetLimits"
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 20261031
          },
          "protocol_version": {
            "type": "string",
            "enum": [
              "boltzfix-v1",
              "boltzfix-v2"
            ],
            "title": "Protocol Version",
            "default": "boltzfix-v1"
          },
          "llm_model": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Llm Model",
            "default": "claude-opus-5-5"
          },
          "hybrid_schedule": {
            "type": "string",
            "enum": [
              "sample_then_minimize",
              "alternate"
            ],
            "title": "Hybrid Schedule",
            "default": "sample_then_minimize"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "ligand_smiles"
        ],
        "title": "RunConfig"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
